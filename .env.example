# ============================================================
# NovaTech Deploy — Variables de entorno
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el .env real al repositorio
# ============================================================

# Base de datos principal
DB_HOST=
DB_PORT=5432
DB_NAME=novatech_prod
DB_USER=
DB_PASSWORD=

# Servicios internos
INTERNAL_API_URL=https://api.novatech.internal
INTERNAL_API_KEY=

# Notificaciones
SLACK_WEBHOOK_URL=
ALERT_EMAIL=infra@novatech.internal

# Storage
S3_BUCKET=
S3_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Entorno
NODE_ENV=production
LOG_LEVEL=info
